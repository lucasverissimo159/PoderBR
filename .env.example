# Backend Configuration
PROJECT_NAME="PoderBR"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Configuration
# Do not commit real credentials. Use appropriate secrets management in production.
DATABASE_URL="sqlite:///./poderbr.db"
# Example Postgres: DATABASE_URL="postgresql://user:password@localhost:5432/poderbr"

# Security
# Define allowed CORS origins as a comma-separated list
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Rate Limiting
# E.g., "100/minute"
RATE_LIMIT_DEFAULT="100/minute"

# Logging
# Valid options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
